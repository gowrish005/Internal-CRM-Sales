generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FOUNDER
  EMPLOYEE
}

// Student-calling pipeline for Leads. Mirrored in lib/lead-status.ts.
enum LeadStatus {
  NEW // not called yet
  HOT // interested
  CALLBACK // asked to be called back
  NO_REPLY // tried, not reached
  WON
  LOST
}

// B2B pipeline for Contacts — separate business, kept as it was.
enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  REFERRAL
  WEBSITE
  COLD_OUTREACH
  EVENT
  SOCIAL_MEDIA
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum EventType {
  MEETING
  CALL
  EVENT
  FOLLOW_UP
}

enum ActivityType {
  CONTACT_CREATED
  CONTACT_UPDATED
  BRANCH_CREATED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  MEETING_CREATED
  MEETING_RESCHEDULED
  TASK_CREATED
  TASK_COMPLETED
  NOTE_ADDED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  password      String
  role          Role      @default(EMPLOYEE)
  image         String?
  isActive      Boolean   @default(true)
  fcmToken      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedContacts Contact[] @relation("ContactOwner")
  ownedLeads    Lead[]    @relation("LeadOwner")
  ownedTasks    Task[]    @relation("TaskOwner")
  organizedMeetings CalendarEvent[] @relation("EventOrganizer")
  participantIn CalendarEvent[] @relation("EventParticipants", fields: [participantEventIds], references: [id])
  participantEventIds String[] @db.ObjectId
  notes         Note[]
  activities    Activity[]
  callLogs      CallLog[]  @relation("UserCallLogs")
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String
  body        String
  type        String
  taskId      String?  @db.ObjectId
  leadId      String?  @db.ObjectId
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}


model Contact {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String
  lastName        String
  email           String?
  phone           String?
  designation     String?
  company         String?
  linkedin        String?
  location        String?
  image           String?
  ownerId         String?   @db.ObjectId
  leadStatus      ContactStatus @default(NEW)
  leadSource      LeadSource?
  priority        Priority  @default(MEDIUM)
  tags            String[]
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner           User?     @relation("ContactOwner", fields: [ownerId], references: [id])
  leads           Lead[]
  meetings        CalendarEvent[]
  tasks           Task[]
  notes           Note[]    @relation("ContactNotes")
  activities      Activity[]
  callLogs        CallLog[] @relation("ContactCallLogs")
}

model Lead {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  // Leads carry their own details; B2B Contacts are a separate founder-managed list.
  phone           String?
  email           String?
  college         String?
  branch          String?
  usn             String?
  passoutYear     Int?
  tags            String[]
  contactId       String?    @db.ObjectId
  ownerId         String?    @db.ObjectId
  source          LeadSource?
  status          LeadStatus @default(NEW)
  priority        Priority   @default(MEDIUM)
  track           Int?
  estimatedValue  Float?
  expectedCloseAt DateTime?
  lastActivityAt  DateTime?
  nextFollowUpAt  DateTime?
  isArchived      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contact         Contact?   @relation(fields: [contactId], references: [id])
  owner           User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  meetings        CalendarEvent[]
  tasks           Task[]
  notes           Note[]     @relation("LeadNotes")
  activities      Activity[]
  callLogs        CallLog[]  @relation("LeadCallLogs")

  // Speeds up the leads panel's filters and the divide feature's "unassigned,
  // not archived" eligibility lookup.
  @@index([isArchived, ownerId])
  @@index([isArchived, status])
  @@index([isArchived, createdAt])
}

model CalendarEvent {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  type          EventType @default(MEETING)
  startAt       DateTime
  endAt         DateTime
  location      String?
  meetingLink   String?
  organizerId   String?   @db.ObjectId
  contactId     String?   @db.ObjectId
  leadId        String?   @db.ObjectId
  color         String?
  isRecurring   Boolean   @default(false)
  notes         String?
  reminderAt    DateTime?
  isCancelled   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizer     User?     @relation("EventOrganizer", fields: [organizerId], references: [id])
  participants  User[]    @relation("EventParticipants", fields: [participantIds], references: [id])
  participantIds String[] @db.ObjectId
  contact       Contact?  @relation(fields: [contactId], references: [id])
  lead          Lead?     @relation(fields: [leadId], references: [id])
  tasks         Task[]
  eventNotes    Note[]    @relation("EventNotes")
  activities    Activity[]
}

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  ownerId     String?    @db.ObjectId
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  contactId   String?    @db.ObjectId
  leadId      String?    @db.ObjectId
  meetingId   String?    @db.ObjectId
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner       User?      @relation("TaskOwner", fields: [ownerId], references: [id])
  contact     Contact?   @relation(fields: [contactId], references: [id])
  lead        Lead?      @relation(fields: [leadId], references: [id])
  meeting     CalendarEvent? @relation(fields: [meetingId], references: [id])
  activities  Activity[]
}

model Note {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  authorId    String   @db.ObjectId
  contactId   String?  @db.ObjectId
  leadId      String?  @db.ObjectId
  meetingId   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
  contact     Contact? @relation("ContactNotes", fields: [contactId], references: [id])
  lead        Lead?    @relation("LeadNotes", fields: [leadId], references: [id])
  meeting     CalendarEvent? @relation("EventNotes", fields: [meetingId], references: [id])
}

model CallLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  contactId       String?  @db.ObjectId
  leadId          String?  @db.ObjectId
  loggedById      String   @db.ObjectId
  calledAt        DateTime
  durationMinutes Int?
  remarks         String
  createdAt       DateTime @default(now())

  contact         Contact? @relation("ContactCallLogs", fields: [contactId], references: [id])
  lead            Lead?    @relation("LeadCallLogs", fields: [leadId], references: [id])
  loggedBy        User     @relation("UserCallLogs", fields: [loggedById], references: [id])
}

model Activity {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  type        ActivityType
  description String
  userId      String?      @db.ObjectId
  contactId   String?      @db.ObjectId
  leadId      String?      @db.ObjectId
  meetingId   String?      @db.ObjectId
  taskId      String?      @db.ObjectId
  metadata    Json?
  createdAt   DateTime     @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  meeting     CalendarEvent? @relation(fields: [meetingId], references: [id])
  task        Task?        @relation(fields: [taskId], references: [id])
}
